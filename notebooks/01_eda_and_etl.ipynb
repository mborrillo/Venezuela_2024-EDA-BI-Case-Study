    "### 1.2 Descargar Datos Automáticamente"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Definir rutas\n",
    "DATA_RAW_DIR = Path('data/raw')\n",
    "DATA_PROCESSED_DIR = Path('data/processed')\n",
    "OUTPUT_DIR = Path('output')\n",
    "\n",
    "# Crear carpetas si no existen\n",
    "for directory in [DATA_RAW_DIR, DATA_PROCESSED_DIR, OUTPUT_DIR]:\n",
    "    directory.mkdir(parents=True, exist_ok=True)\n",
    "    print(f'✓ Carpeta verificada: {directory}')\n",
    "\n",
    "# URL del archivo CSV\n",
    "CSV_URL = 'https://static.resultadosconvzla.com/RESULTADOS_2024_CSV_V2.csv'\n",
    "CSV_PATH = DATA_RAW_DIR / 'RESULTADOS_2024_CSV_V2.csv'\n",
    "\n",
    "print(f'\\n📥 Descargando datos desde: {CSV_URL}')\n",
    "\n",
    "# Descargar con manejo de errores\n",
    "try:\n",
    "    if not CSV_PATH.exists():\n",
    "        print('Descargando archivo...')\n",
    "        urlretrieve(CSV_URL, CSV_PATH)\n",
    "        print(f'✅ Archivo descargado: {CSV_PATH}')\n",
    "        print(f'   Tamaño: {CSV_PATH.stat().st_size / (1024*1024):.2f} MB')\n",
    "    else:\n",
    "        print(f'✓ Archivo ya existe: {CSV_PATH}')\n",
    "        print(f'   Tamaño: {CSV_PATH.stat().st_size / (1024*1024):.2f} MB')\n",
    "except Exception as e:\n",
    "    print(f'⚠️ Error descargando: {e}')\n",
    "    print('💡 Asegúrate de tener conexión a internet o descarga manualmente')"
   ]
