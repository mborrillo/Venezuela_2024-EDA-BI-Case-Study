    "### 1.4 Limpieza y Transformación"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Crear copia de trabajo\n",
    "df_clean = df.copy()\n",
    "\n",
    "print('🧹 INICIANDO LIMPIEZA\\n')\n",
    "\n",
    "# 1. Valores nulos\n",
    "print('1️⃣ Valores nulos:')\n",
    "nulls = df_clean.isnull().sum()\n",
    "if nulls.sum() > 0:\n",
    "    print(nulls[nulls > 0])\n",
    "    print('   ⚠️ Rellenando con 0...')\n",
    "    df_clean = df_clean.fillna(0)\n",
    "else:\n",
    "    print('   ✓ Sin valores nulos')\n",
    "\n",
    "# 2. Normalizar nombres de columnas\n",
    "print('\\n2️⃣ Normalizando nombres de columnas...')\n",
    "df_clean.columns = df_clean.columns.str.lower().str.strip()\n",
    "print(f'   ✓ {len(df_clean.columns)} columnas normalizadas')\n",
    "\n",
    "# 3. Convertir tipos de datos\n",
    "print('\\n3️⃣ Ajustando tipos de datos...')\n",
    "numeric_cols = df_clean.select_dtypes(include=['object']).columns\n",
    "for col in numeric_cols:\n",
    "    try:\n",
    "        df_clean[col] = pd.to_numeric(df_clean[col], errors='coerce')\n",
    "    except:\n",
    "        pass\n",
    "print('   ✓ Tipos de datos ajustados')\n",
    "\n",
    "# 4. Crear columnas calculadas\n",
    "print('\\n4️⃣ Creando columnas calculadas...')\n",
    "\n",
    "# Identificar columnas de candidatos (asumiendo que son numéricas después de la conversión)\n",
    "candidato_cols = [col for col in df_clean.columns if col.lower() not in \n",
    "                  ['estado', 'municipio', 'centro', 'mesas', 'votos_validos', 'votos_nulos', 'centro_id']]\n",
    "\n",
    "# Suma de votos válidos\n",
    "if len(candidato_cols) > 0:\n",
    "    df_clean['votos_totales'] = df_clean[candidato_cols].sum(axis=1)\n",
    "    print(f'   ✓ Columna votos_totales creada')\n",
    "\n",
    "print('\\n✅ LIMPIEZA COMPLETADA')"
   ]
